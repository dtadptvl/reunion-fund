# ==============================================================================
# REUNION FUND — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit real .env files or secrets to source control.

# Server Network Configuration
HOST=0.0.0.0
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Storage & SQLite Database
DATABASE_PATH=./data/reunion.db
STORAGE_PATH=./data/uploads

# SePay Configuration (Sandbox / Live)
# Environment options: sandbox | live
SEPAY_ENVIRONMENT=sandbox
SEPAY_BASE_URL=https://userapi-sandbox.sepay.vn/v2
SEPAY_API_TOKEN=your_sepay_api_token_here
SEPAY_WEBHOOK_SECRET=your_sepay_webhook_hmac_secret_here

# Banking Info for VietQR Display
SEPAY_BANK_ACCOUNT=0123456789
SEPAY_BANK_NAME=MBBank
SEPAY_ACCOUNT_NAME=NGUYEN VAN THU QUY

# Google Gemini AI Configuration (Assistive expense classification only)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Treasurer Authentication & Session
ADMIN_USERNAME=thuquy
# Generate Argon2id hash for password, e.g. using npx argon2-cli or internal script
ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$placeholder$placeholder
SESSION_SECRET=please_generate_a_random_64_character_hex_string_for_session_encryption

# Financial Settings
DEFAULT_CONTRIBUTION_AMOUNT=500000
REUNION_EVENT_TITLE=LỚP A1 — KHÓA 48

# Reconciliation Scheduler
RECONCILIATION_CRON=30 3 * * *
AUTO_RECONCILE_ON_STARTUP=true
